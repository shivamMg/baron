AML_COMPUTE_RESOURCE_IDS=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.MachineLearningServices/workspaces/<workspace>/computes/<preferred-compute>,/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.MachineLearningServices/workspaces/<workspace>/computes/<fallback-compute>
STORAGE_ACCOUNT_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<storage-account>
STORAGE_CONTAINER=<container>
AML_SSH_USER=<user>
AML_SSH_PASSWORD=<password>

# Required for real training; dry runs default to dry-run when omitted.
BARON_RUN_ID=<run-id>
BARON_IMAGE=<registry>/<repository>@sha256:<digest>
BARON_DURABLE_PATH=/mnt/baron-training
BARON_LOCAL_PATH=/mnt/baron-local
BARON_SERVICE_USER=<user>
BARON_TRAINING_ENABLED=false
BARON_DRY_RUN_STEPS=3
BARON_DRY_RUN_INTERVAL_SECONDS=1
# Must resolve on the node host and inside the container; keep it under BARON_DURABLE_PATH.
BARON_CONFIG_PATH=<config-path-under-durable-mount>
BARON_CONFIG_HASH=<sha256>
BARON_PROGRESS_TIMEOUT_SECONDS=600